# Loopback-only lab placeholders. Compose binds 0.0.0.0 inside the container
# (non-loopback); replace both values with unique roots before compose up or
# startup refuses the shipped example pair. Host publish stays 127.0.0.1:4599.
NOCTAXRIS_AZ_ROOT_CLIENT_ID=00000000-0000-0000-0000-00000000root
NOCTAXRIS_AZ_ROOT_ACCESS_TOKEN=noctaxris-az-example-root-token
NOCTAXRIS_AZ_TENANT_ID=00000000-0000-0000-0000-000000000001
NOCTAXRIS_AZ_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000002

# Stock compose.yaml sets NOCTAXRIS_AZ_TLS_AUTO=1 and
# NOCTAXRIS_AZ_PUBLIC_URL=https://127.0.0.1:4599. Download the lab CA from
# GET /_noctaxris-az/ca.pem (or /_lab/ca.pem when NOCTAXRIS_AZ_STRIP_PRODUCT=1)
# and trust it before az login / SDK calls.

# Compose sets NOCTAXRIS_AZ_MASTER_KEY_FILE=/var/lib/noctaxris-az-secrets/master.key
# on the noctaxris-az-secrets volume (outside noctaxris-az-data). Do not colocate
# master.key on the data volume unless you also set:
# NOCTAXRIS_AZ_ALLOW_MASTER_KEY_IN_DATA_ROOT=1
# NOCTAXRIS_AZ_MASTER_KEY_FILE=/var/lib/noctaxris-az/master.key

# Nested DinD is opt-in via compose.engine.yaml (default OFF; empty DOCKER_HOST).
# Never set these to unix:///var/run/docker.sock or mount host docker.sock.
